{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoFailover 3.0",
  "version": "3.0.0",
  "identifier": "com.modula.autofailover",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoFailover 3.0 by Modula",
        "width": 1120,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Network",
    "copyright": "Copyright (c) 2026 parikesitad-pm",
    "shortDescription": "AutoFailover 3.0 by Modula",
    "longDescription": "High-contrast digital network cockpit and sub-second failover engine for real-time workload protection."
  }
}
